---
import Base from '../layouts/Base.astro';
import Sprite from '../components/Sprite.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Demo from '../components/Demo.astro';
import Problem from '../components/Problem.astro';
import Race from '../components/Race.astro';
import Modes from '../components/Modes.astro';
import Receipt from '../components/Receipt.astro';
import UnderTheHood from '../components/UnderTheHood.astro';
import Guarantees from '../components/Guarantees.astro';
import Config from '../components/Config.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Horsy · Just the right horsepower"
  description="Horsy is a Claude Code plugin. It sends each subtask to the cheapest model that can do it, checks the work, and steps up a model if the check fails."
>
  <Sprite />
  <Nav />
  <Hero />
  <Demo />
  <Problem />
  <Race />
  <Modes />
  <Receipt />
  <UnderTheHood />
  <Guarantees />
  <Config />
  <Faq />
  <FinalCta />
  <Footer />
</Base>

<script>
  import '../scripts/smooth';
  import '../scripts/nav';
  import '../scripts/reveal';
  import '../scripts/race';
  import '../scripts/scrollfx';
  import '../scripts/receipt';
  import '../scripts/media';
  import '../scripts/copy';
</script>
